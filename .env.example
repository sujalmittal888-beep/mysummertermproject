# --- Application ---
TASKFLOW_ENV=development
TASKFLOW_LOG_LEVEL=INFO
TASKFLOW_ARTIFACT_DIR=./artifacts

# --- LLM Provider: one of "openai" | "anthropic" | "mock" ---
TASKFLOW_LLM_PROVIDER=mock
TASKFLOW_LLM_MODEL=
TASKFLOW_OPENAI_API_KEY=
TASKFLOW_ANTHROPIC_API_KEY=

# --- Database ---
TASKFLOW_DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@localhost:5432/taskflow
